  "C-NCAP-2027-J": { "match": "附录\\s*J|Appendix\\s*J" },
  "C-NCAP-2027-M": { "match": "附录\\s*M|Appendix\\s*M" },

  "C-IASI-17": { "match": "头枕静态|17" },
